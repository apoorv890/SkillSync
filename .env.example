# Legacy API (SkillSync-server) listens on PORT (default 5500) when behind the gateway.
# API gateway listens on GATEWAY_PORT (default 5000). The Vite client targets port 5000.
PORT=5500
GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
JOBS_SERVICE_PORT=5002

# Shared secret for auth-service /api/internal/* and legacy API authClient (X-Internal-Token).
INTERNAL_SERVICE_TOKEN=change_me_to_a_long_random_string

# Optional overrides (defaults match local dev).
# AUTH_SERVICE_URL=http://127.0.0.1:5001
# JOBS_SERVICE_URL=http://127.0.0.1:5002

MONGODB_URI=mongodb://localhost:27017/SkillSync
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
GROQ_API_KEY=your_groq_api_key_here
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
COMPANY_NAME=Your Company Name
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here
