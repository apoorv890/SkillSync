# Copy this file to `.env` at the repository root (same folder as package.json).
# Monolith server listens on PORT (default 5000). The Vite client targets port 5000.
PORT=5000

# Docker Compose overrides MONGODB_URI internally; keep JWT / AWS / Gemini here.
# Run: `npm run dev:docker` (foreground) or `docker compose up --build -d`.

MONGODB_URI=mongodb://localhost:27017/SkillSync
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Google Sign-In (Web client ID from Google Cloud Console → OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
# Same value for Vite — loaded from this file (client/vite.config `envDir` = repo root). Restart `npm run dev` after edits.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
# Google Gemini (ATS in resume-analysis; admin candidate bulk scoring in applications)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model ids (defaults: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_ATS_MODEL=gemini-2.0-flash
# GEMINI_CANDIDATE_MODEL=gemini-2.0-flash
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
COMPANY_NAME=Your Company Name
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here

# Phone-agent (Twilio Media Streams + outbound call trigger)
# SkillSync server uses PHONE_AGENT_BASE_URL to call the agent (server-to-server).
PHONE_AGENT_BASE_URL=http://localhost:3010

# phone-agent required vars (read by phone-agent/src/config.js)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=
# Optional default outbound destination if /twilio/call is called without { "to": "..." }
OUTBOUND_TO=

# Phone-agent → SkillSync (tool calls: context, calendar). Same token must be set on server.
# Host dev: use localhost (or 127.0.0.1). Docker Compose overrides this to http://server:5000 inside the phone-agent service.
SKILLSYNC_API_BASE_URL=http://localhost:5000
SKILLSYNC_SERVICE_TOKEN=

# Admin whose calendar is used when the AI books interviews (Mongo ObjectId string).
# Optional if only one admin has connected Google Calendar via /api/calendar/auth-url.
GOOGLE_CALENDAR_ADMIN_USER_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback
