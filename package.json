{
  "name": "skillsync",
  "private": true,
  "version": "1.0.0",
  "description": "SkillSync - AI-powered recruitment platform",
  "workspaces": [
    "client",
    "server",
    "shared",
    "gateway",
    "services/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:client": "npm run dev --workspace=SkillSync-client",
    "dev:server": "npm run dev --workspace=SkillSync-server",
    "dev:gateway": "npm run dev --workspace=@skillsync/gateway",
    "dev:auth": "npm run dev --workspace=@skillsync/auth-service",
    "dev:jobs": "npm run dev --workspace=@skillsync/jobs-service",
    "seed:jobs": "npm run seed:jobs --workspace=@skillsync/jobs-service",
    "dev:applications": "npm run dev --workspace=@skillsync/applications-service",
    "dev:resume-analysis": "npm run dev --workspace=@skillsync/resume-analysis-service",
    "dev:search": "npm run dev --workspace=@skillsync/search-service",
    "dev:dashboard": "npm run dev --workspace=@skillsync/dashboard-service",
    "dev:services": "concurrently -n gateway,auth,jobs,apps,resume,search,dash -c blue,green,yellow,magenta,cyan,red,white \"npm:dev:gateway\" \"npm:dev:auth\" \"npm:dev:jobs\" \"npm:dev:applications\" \"npm:dev:resume-analysis\" \"npm:dev:search\" \"npm:dev:dashboard\"",
    "dev": "concurrently -n client,gateway,api,auth,jobs,apps,search,resume -c blue,magenta,green,yellow,cyan,white,gray,red \"npm run dev:client\" \"npm run dev:gateway\" \"npm run dev:server\" \"npm run dev:auth\" \"npm run dev:jobs\" \"npm run dev:applications\" \"npm run dev:search\" \"npm run dev:resume-analysis\"",
    "build:client": "npm run build --workspace=SkillSync-client",
    "start:server": "npm start --workspace=SkillSync-server",
    "start": "npm run build:client && npm run start:server"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
