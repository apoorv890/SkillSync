# Gemini Live API
GEMINI_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public HTTPS URL (ngrok or production). Used for TwiML voice URL and WSS stream URL.
# Example: https://abc123.ngrok-free.app
PUBLIC_BASE_URL=

# Server port (optional, default 3000)
PORT=3000

# Default outbound number when POST /twilio/call has no JSON body (optional)
# Or POST JSON: { "to": "+15551234567" }
OUTBOUND_TO=
